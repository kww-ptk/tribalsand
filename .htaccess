RewriteEngine On

# Redirect /foo.php → /foo only when a browser NAVIGATES to .php (GET/HEAD).
# Must NOT match POST: a 301 on a form submission makes the browser re-issue
# it as a GET and drop the body, silently breaking every admin save.
RewriteCond %{THE_REQUEST} ^(?:GET|HEAD)\s/(.+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Strip-.php: serve /foo from foo.php internally
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# Proxy missing images/assets to live site (mirrors router.php behaviour)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule \.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|pdf|mp4|mp3)$ https://tribalsand.com%{REQUEST_URI} [R=302,L]
