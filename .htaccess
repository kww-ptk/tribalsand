RewriteEngine On

# --- A1: Lock down secret files ---------------------------------------------
# On the live server, .env / *.sql / .git / /db/ etc. must never be downloadable
# (a leaked .env = leaked database password). Deny them outright.
Options -Indexes
ErrorDocument 404 /404.php
<FilesMatch "(^\.|\.env|\.sql$|\.md$|\.log$|^composer\.(json|lock)$|^package(-lock)?\.json$|^router\.php$)">
  Require all denied
</FilesMatch>
RedirectMatch 404 (?i)/(\.git|logs|docs|deploy|db)(/|$)
# ----------------------------------------------------------------------------

# --- Dynamic sitemap --------------------------------------------------------
# /sitemap.xml (the URL registered with search engines) is generated by
# sitemap.php from the page list + article manifest, so it never drifts.
RewriteRule ^sitemap\.xml$ sitemap.php [L]
# ----------------------------------------------------------------------------

# --- Legacy cutover redirects (non-.php paths) ------------------------------
# Old-site ranked URLs with NO file on the new site. Page-slug legacy URLs are
# handled by per-file 301 stubs (they resolve via strip-.php); only paths that
# can't be a .php stub live here. Single 301 → closest live page (never home).
# Placed BEFORE the image/asset proxy so the PDF resolves to its 301, not a proxy.
# Old inventory diffed in docs/redirects-map.csv. Keep both in sync.
RewriteRule ^content/Watamu-Kenya-COMETA-2025\.pdf$ /watamu [R=301,L]
# ----------------------------------------------------------------------------

# Serve POST/PUT/PATCH/DELETE to a .php URL DIRECTLY — never redirect. A 301 on a
# form submission makes the browser re-issue it as GET and DROP the body (the CSRF
# token + all fields), silently breaking every save/submit (guest check-in, admin,
# enquiry forms). Guard on the real request method so it can't be bypassed.
RewriteCond %{REQUEST_METHOD} !^(?:GET|HEAD)$
RewriteRule \.php$ - [L]

# Redirect /foo.php → /foo only when a browser NAVIGATES to .php (GET/HEAD).
# Behind CloudFront the app sees Host = the .on.aws origin (over http), so a
# bare path-only redirect (Apache derives the Location host/scheme from
# HTTP_HOST) bounces visitors onto the ugly http://…on.aws origin. On the
# production hosts, force the canonical https://tribalsand.com so clean-URL
# links keep the visitor on the real domain. Keep a path-only fallback so
# local dev (localhost) and any other host still work.
RewriteCond %{HTTP_HOST} (?:\.on\.aws|tribalsand\.com)$ [NC]
RewriteCond %{THE_REQUEST} ^(?:GET|HEAD)\s/(.+)\.php[\s?] [NC]
RewriteRule ^ https://tribalsand.com/%1 [R=301,L]

RewriteCond %{THE_REQUEST} ^(?:GET|HEAD)\s/(.+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Strip-.php: serve /foo from foo.php internally
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# Serve any static asset not present in THIS container from the CloudFront CDN
# (origin = the S3 tribalsand-images bucket, which holds the full /images tree plus
# every uploaded photo). This catches DB root-relative "/images/..." values and any
# hardcoded https://tribalsand.com/images/... refs once tribalsand.com points here.
# Redirecting to a DIFFERENT host (CloudFront) is loop-safe even when this server IS
# tribalsand.com, so no host guard is needed. asset_url()-based refs bypass this and
# hit CloudFront directly via the ASSET_URL env var.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule \.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|pdf|mp4|mp3)$ https://d38di21ab22p6u.cloudfront.net%{REQUEST_URI} [R=302,L]
