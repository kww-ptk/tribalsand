RewriteEngine On

# --- A1: Lock down secret files ---------------------------------------------
# On the live server, .env / *.sql / .git / /db/ etc. must never be downloadable
# (a leaked .env = leaked database password). Deny them outright.
Options -Indexes
ErrorDocument 404 /404.php
<FilesMatch "(^\.|\.env|\.sql$|\.md$|\.log$|^composer\.(json|lock)$|^package(-lock)?\.json$|^router\.php$)">
  Require all denied
</FilesMatch>
RedirectMatch 404 (?i)/(\.git|logs|docs|deploy|db)(/|$)
# ----------------------------------------------------------------------------

# --- Dynamic sitemap --------------------------------------------------------
# /sitemap.xml (the URL registered with search engines) is generated by
# sitemap.php from the page list + article manifest, so it never drifts.
RewriteRule ^sitemap\.xml$ sitemap.php [L]
# ----------------------------------------------------------------------------

# --- Legacy cutover redirects (non-.php paths) ------------------------------
# Old-site ranked URLs with NO file on the new site. Page-slug legacy URLs are
# handled by per-file 301 stubs (they resolve via strip-.php); only paths that
# can't be a .php stub live here. Single 301 → closest live page (never home).
# Placed BEFORE the image/asset proxy so the PDF resolves to its 301, not a proxy.
# Old inventory diffed in docs/redirects-map.csv. Keep both in sync.
RewriteRule ^content/Watamu-Kenya-COMETA-2025\.pdf$ /watamu [R=301,L]

# Trip Builder — one page, one lead source.
# Three copies of the builder were live and all POSTed to the SAME GHL webhook
# with an identical payload (source: 'Trip Builder', same tags, same TS-<year>-
# <n> ref), so enquiries were impossible to attribute. Worse, the two .html
# copies posted their backend call to https://www.tribalsand.com/tribal-sand/
# api/submit.php — dead since the rewrite — so those leads reached GHL only,
# with no confirmation email and no row in `submissions`.
# /trip-builder (trip-builder.php) is the only real one: it is in sitemap.xml
# and posts to /api/trip-builder.php, which stores the submission and emails.
# The v3 name is also matched at the site root, where it 404s today, because
# the old blog page links to it relatively.
# Force the canonical https host on the production hosts, exactly as the
# strip-.php rules below do: behind CloudFront the app sees Host = the .on.aws
# origin over http, so a path-only target makes Apache build
# http://…on.aws/trip-builder — a URL the browser cannot reach, because the
# origin only answers https via CloudFront. Path-only fallback second so local
# dev and any other host still redirect.
RewriteCond %{HTTP_HOST} (?:\.on\.aws|tribalsand\.com)$ [NC]
RewriteRule ^trip-builder\.html$ https://tribalsand.com/trip-builder [R=301,L]
RewriteRule ^trip-builder\.html$ /trip-builder [R=301,L]

RewriteCond %{HTTP_HOST} (?:\.on\.aws|tribalsand\.com)$ [NC]
RewriteRule ^(?:reference/)?tribal-sand-trip-builder-v3\.html$ https://tribalsand.com/trip-builder [R=301,L]
RewriteRule ^(?:reference/)?tribal-sand-trip-builder-v3\.html$ /trip-builder [R=301,L]

# Retired pages. Each was live but reachable only by direct URL — nothing in the
# site linked to them and none was in sitemap.xml. Deleted from the repo and 301'd
# to the live equivalent so any external link or ranked URL still lands somewhere
# real. Same host guard as above: a path-only target would send visitors to the
# unreachable .on.aws origin.
#
#   tribalsand-blog-tribal-dunes.html -> now a proper Journal article
#   tribal-sand-activity(-20).html    -> two near-duplicate "Book an Experience" pages
#   tribalsand_sitemap.html           -> superseded by interactive-site-map.php
#   reservation.php                   -> two <form>s with no action and no handler
#   search-result.php                 -> superseded by search.php
#   tribalsandstory1.php              -> an early My Amani page
#   health.php                        -> 10-line placeholder, no content
#   processproperties.php             -> debug stub that echoed "live - sssss"
RewriteCond %{HTTP_HOST} (?:\.on\.aws|tribalsand\.com)$ [NC]
RewriteRule ^tribalsand-blog-tribal-dunes\.html$ https://tribalsand.com/tribal-dunes-beachfront-village-kilifi [R=301,L]
RewriteRule ^tribalsand-blog-tribal-dunes\.html$ /tribal-dunes-beachfront-village-kilifi [R=301,L]

RewriteCond %{HTTP_HOST} (?:\.on\.aws|tribalsand\.com)$ [NC]
RewriteRule ^tribal-sand-activity(?:-20)?\.(?:html|php)$ https://tribalsand.com/activities [R=301,L]
RewriteRule ^tribal-sand-activity(?:-20)?\.(?:html|php)$ /activities [R=301,L]

RewriteCond %{HTTP_HOST} (?:\.on\.aws|tribalsand\.com)$ [NC]
RewriteRule ^tribalsand_sitemap\.html$ https://tribalsand.com/interactive-site-map [R=301,L]
RewriteRule ^tribalsand_sitemap\.html$ /interactive-site-map [R=301,L]

RewriteCond %{HTTP_HOST} (?:\.on\.aws|tribalsand\.com)$ [NC]
RewriteRule ^reservation(?:\.php)?$ https://tribalsand.com/reserve [R=301,L]
RewriteRule ^reservation(?:\.php)?$ /reserve [R=301,L]

RewriteCond %{HTTP_HOST} (?:\.on\.aws|tribalsand\.com)$ [NC]
RewriteRule ^search-result(?:\.php)?$ https://tribalsand.com/search [R=301,L]
RewriteRule ^search-result(?:\.php)?$ /search [R=301,L]

RewriteCond %{HTTP_HOST} (?:\.on\.aws|tribalsand\.com)$ [NC]
RewriteRule ^tribalsandstory1(?:\.php)?$ https://tribalsand.com/my-amani [R=301,L]
RewriteRule ^tribalsandstory1(?:\.php)?$ /my-amani [R=301,L]

RewriteCond %{HTTP_HOST} (?:\.on\.aws|tribalsand\.com)$ [NC]
RewriteRule ^(?:health|processproperties)(?:\.php)?$ https://tribalsand.com/ [R=301,L]
RewriteRule ^(?:health|processproperties)(?:\.php)?$ / [R=301,L]

# /reference/ holds pre-cutover copies of pages — an old blog, an old trip
# builder, an old property page, each carrying its own stale copy of the chat
# widget embed. They were being served publicly at 200 and were crawlable.
# Kept in the repo (interactive-site-map.php reads tribalsand_sitemap.html from
# here as an image fallback, and they are useful design reference) but no longer
# reachable over HTTP. Placed AFTER the trip-builder rule above so that one
# still 301s rather than 404ing.
RewriteRule ^reference/ - [R=404,L]
# ----------------------------------------------------------------------------

# Serve POST/PUT/PATCH/DELETE to a .php URL DIRECTLY — never redirect. A 301 on a
# form submission makes the browser re-issue it as GET and DROP the body (the CSRF
# token + all fields), silently breaking every save/submit (guest check-in, admin,
# enquiry forms). Guard on the real request method so it can't be bypassed.
RewriteCond %{REQUEST_METHOD} !^(?:GET|HEAD)$
RewriteRule \.php$ - [L]

# Directory requested WITHOUT a trailing slash (e.g. /admin). Apache's mod_dir
# would 301 to add the slash, but behind CloudFront it derives that redirect from
# the origin Host over http (→ http://…on.aws/admin/), which the browser cannot
# reach (the origin only answers https, via CloudFront) — so the visitor dead-ends
# on a "Not Found". Pre-empt mod_dir and issue the slash redirect on the canonical
# https host ourselves (same fix as the .php rules below). GET/HEAD only so a POST
# body is never dropped. Keep a path-only fallback so local dev / other hosts work.
RewriteCond %{HTTP_HOST} (?:\.on\.aws|tribalsand\.com)$ [NC]
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^ https://tribalsand.com%{REQUEST_URI}/ [R=301,L]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^ %{REQUEST_URI}/ [R=301,L]

# Redirect /foo.php → /foo only when a browser NAVIGATES to .php (GET/HEAD).
# Behind CloudFront the app sees Host = the .on.aws origin (over http), so a
# bare path-only redirect (Apache derives the Location host/scheme from
# HTTP_HOST) bounces visitors onto the ugly http://…on.aws origin. On the
# production hosts, force the canonical https://tribalsand.com so clean-URL
# links keep the visitor on the real domain. Keep a path-only fallback so
# local dev (localhost) and any other host still work.
RewriteCond %{HTTP_HOST} (?:\.on\.aws|tribalsand\.com)$ [NC]
RewriteCond %{THE_REQUEST} ^(?:GET|HEAD)\s/(.+)\.php[\s?] [NC]
RewriteRule ^ https://tribalsand.com/%1 [R=301,L]

RewriteCond %{THE_REQUEST} ^(?:GET|HEAD)\s/(.+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Strip-.php: serve /foo from foo.php internally
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+)$ $1.php [L]

# Serve any static asset not present in THIS container from the CloudFront CDN
# (origin = the S3 tribalsand-images bucket, which holds the full /images tree plus
# every uploaded photo). This catches DB root-relative "/images/..." values and any
# hardcoded https://tribalsand.com/images/... refs once tribalsand.com points here.
# Redirecting to a DIFFERENT host (CloudFront) is loop-safe even when this server IS
# tribalsand.com, so no host guard is needed. asset_url()-based refs bypass this and
# hit CloudFront directly via the ASSET_URL env var.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule \.(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|pdf|mp4|mp3)$ https://d38di21ab22p6u.cloudfront.net%{REQUEST_URI} [R=302,L]
