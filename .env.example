# ─────────────────────────────────────────────────────────────
# Tribal Sand — environment template
# Copy to `.env`:   cp .env.example .env      (`.env` is git-ignored; never commit secrets)
#
# The values below are LOCAL DEVELOPMENT defaults — they work as-is. See README.md.
#  • Docker (`docker compose up`): docker-compose.yml sets the database, mail and URL
#    itself, so .env is optional — use it only for your own extra keys (AI, etc.).
#  • Native (PHP + PostgreSQL installed yourself): point DATABASE_URL at your local DB.
#
# PRODUCTION does not read this file: its values are ECS task environment
# variables on AWS. Never put production credentials in a local .env, and never
# point a local .env at the production database.
# ─────────────────────────────────────────────────────────────

# Database — PostgreSQL. LOCAL database only (bin/dev-setup.php refuses anything else).
DATABASE_URL=postgres://tribalsand:tribalsand@127.0.0.1:5432/tribalsand

# Site URL (no trailing slash). Drives email links, sitemap and site_url().
APP_URL=http://localhost:8765

# Password for the local test logins bin/dev-setup.php creates:
#   owner@tribalsand.test · manager@tribalsand.test · reception@tribalsand.test · frontdesk@tribalsand.test
# Local database only. Docker uses the same default (docker-compose.yml).
DEV_ADMIN_PASSWORD=TribalLocal-2026

# ─────────────────────────────────────────────────────────────
# Everything below is OPTIONAL locally. Leave blank unless you are testing
# that integration. (Reference for what production sets.)
# ─────────────────────────────────────────────────────────────

# AI assistant / guest concierge — hidden until a key is set.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=          # also used for the RAG embeddings
# AI_PROVIDER=claude

# Mail — Resend (https://resend.com). If RESEND_API_KEY is set, all email
# goes through the Resend API. MAIL_FROM must be on a Resend-verified domain.
RESEND_API_KEY=
MAIL_FROM=Tribal Sand <noreply@tribalsand.com>
# MAIL_DRIVER: 'smtp' (uses SMTP_* vars) or 'log' (writes emails to logs/mail.log
# for local dev — no mailserver needed). Ignored when RESEND_API_KEY is set.
# (Docker ignores this: it sends every email to Mailpit at http://localhost:8025.)
MAIL_DRIVER=log

# Cloudflare Turnstile (anti-spam — free keys at dash.cloudflare.com/?to=/:account/turnstile).
# Both keys must be set in production, or verify_captcha() fails closed.
# Leave BOTH empty for local dev to bypass the check.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Hold/booking token signing (one-click Confirm/Decline buttons in admin emails).
# Generate with: openssl rand -hex 32   (any long random string is fine locally)
BOOKING_TOKEN_SECRET=local-dev-only-booking-token-secret-0000

# iCal sync — protects /api/sync-ical.php (sent via Authorization: Bearer header).
# Generate with: openssl rand -hex 20
ICAL_SYNC_SECRET=

# Restaurant integration API — lets a standalone restaurant site (the Zuri
# restaurant website) render the live menu from Admin → Menus and post table
# bookings into Admin → Reservations. See docs/restaurant-api.md.
#   Reads  (/api/menu-feed.php)       — key OPTIONAL; unset = public, like /menu.php.
#   Writes (/api/reservation-api.php) — key REQUIRED; unset = endpoint disabled (503),
#                                       so a missing value can never open an
#                                       unauthenticated writer.
# Generate with: openssl rand -hex 32
RESTAURANT_API_KEY=

# ─────────────────────────────────────────────────────────────
# Cloudflare R2 image storage (admin uploads).
# OPTIONAL, but REQUIRED for uploaded photos to survive redeploys — without
# it, storage.php falls back to the container's local disk, which is wiped on
# every deploy. Set all of R2_ACCOUNT_ID + R2_ACCESS_KEY + R2_SECRET_KEY to
# enable. R2_BUCKET defaults to "tribalsand-images" if omitted.
# ─────────────────────────────────────────────────────────────
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_BUCKET=tribalsand-images
# R2_ACCESS_KEY=your_r2_access_key_id
# R2_SECRET_KEY=your_r2_secret_access_key
# R2_PUBLIC_URL=https://pub-XXXX.r2.dev

# ─────────────────────────────────────────────────────────────
# Pre-Check-in private files (passport scans, signed waivers) — SENSITIVE PII.
# NEVER web-served; read only through admin/checkin-file.php. In order of preference:
#  1) R2_CHECKIN_BUCKET — a DEDICATED PRIVATE R2 bucket with NO public domain / no
#     R2_PUBLIC_URL binding (do NOT reuse R2_BUCKET, which is public). Persistent + private.
#  2) CHECKIN_STORAGE_DIR — an absolute path OUTSIDE the web root, ideally a
#     persistent volume mount (so files survive deploys).
#  3) Neither set → the system temp dir: private, but WIPED on every deploy (dev only).
# ─────────────────────────────────────────────────────────────
# R2_CHECKIN_BUCKET=tribalsand-checkin-private
# CHECKIN_STORAGE_DIR=/var/data/checkin
