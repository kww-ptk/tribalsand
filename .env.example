# ─────────────────────────────────────────────────────────────
# Tribal Sand — environment template
# Copy to `.env` and fill in. `.env` is git-ignored; never commit real secrets.
# In production these are set as the host's environment variables (AWS SSM / ECS
# task env), not in this file.
# ─────────────────────────────────────────────────────────────

# Database — PostgreSQL (Neon). Single connection string.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Site — canonical public URL (no trailing slash). Drives email links,
# sitemap, and site_url()/APP_URL helpers. Falls back to the request host if unset.
APP_URL=https://tribalsand.com

# Mail — Resend (https://resend.com). If RESEND_API_KEY is set, all email
# goes through the Resend API. MAIL_FROM must be on a Resend-verified domain.
RESEND_API_KEY=
MAIL_FROM=Tribal Sand <noreply@tribalsand.com>
# MAIL_DRIVER: 'smtp' (uses SMTP_* vars) or 'log' (writes emails to logs/mail.log
# for local dev — no mailserver needed). Ignored when RESEND_API_KEY is set.
MAIL_DRIVER=

# Cloudflare Turnstile (anti-spam — free keys at dash.cloudflare.com/?to=/:account/turnstile).
# Both keys must be set in production, or verify_captcha() fails closed.
# Leave BOTH empty for local dev to bypass the check.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Hold/booking token signing (one-click Confirm/Decline buttons in admin emails).
# Generate with: openssl rand -hex 32
BOOKING_TOKEN_SECRET=

# iCal sync — protects /api/sync-ical.php (sent via Authorization: Bearer header).
# Generate with: openssl rand -hex 20
ICAL_SYNC_SECRET=

# ─────────────────────────────────────────────────────────────
# Cloudflare R2 image storage (admin uploads).
# OPTIONAL, but REQUIRED for uploaded photos to survive redeploys — without
# it, storage.php falls back to the container's local disk, which is wiped on
# every deploy. Set all of R2_ACCOUNT_ID + R2_ACCESS_KEY + R2_SECRET_KEY to
# enable. R2_BUCKET defaults to "tribalsand-images" if omitted.
# ─────────────────────────────────────────────────────────────
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_BUCKET=tribalsand-images
# R2_ACCESS_KEY=your_r2_access_key_id
# R2_SECRET_KEY=your_r2_secret_access_key
# R2_PUBLIC_URL=https://pub-XXXX.r2.dev

# ─────────────────────────────────────────────────────────────
# Pre-Check-in private files (passport scans, signed waivers) — SENSITIVE PII.
# NEVER web-served; read only through admin/checkin-file.php. In order of preference:
#  1) R2_CHECKIN_BUCKET — a DEDICATED PRIVATE R2 bucket with NO public domain / no
#     R2_PUBLIC_URL binding (do NOT reuse R2_BUCKET, which is public). Persistent + private.
#  2) CHECKIN_STORAGE_DIR — an absolute path OUTSIDE the web root, ideally a
#     persistent volume mount (so files survive deploys).
#  3) Neither set → the system temp dir: private, but WIPED on every deploy (dev only).
# ─────────────────────────────────────────────────────────────
# R2_CHECKIN_BUCKET=tribalsand-checkin-private
# CHECKIN_STORAGE_DIR=/var/data/checkin
